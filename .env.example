# Neon Postgres connection string (used by the live app)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Supabase credentials — only required to run the one-shot migration script.
# Safe to remove from the deployed environment after migration completes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
