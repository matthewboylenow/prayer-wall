# Neon Postgres connection string (required)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Shared password for the staff review page at /admin (required for /admin)
ADMIN_PASSWORD=

# Turns on the AI vetting layer. Without it, only the word rules run and
# anything they are unsure about waits for staff.
ANTHROPIC_API_KEY=

# Optional: override the model used for AI vetting (default claude-opus-5-5)
# MODERATION_MODEL=claude-haiku-5-5

# Optional: salt for hashing submitter IPs for rate limiting. Falls back to ADMIN_PASSWORD.
# HASH_SECRET=
